# =============================================================
# Morning Agent — environment template
# Copy to .env (which is gitignored) and fill in real values.
# In GitHub Actions, set each of these as a repository Secret.
# =============================================================

# --- Delivery: ntfy.sh ---------------------------------------
# Pick a hard-to-guess topic name; anyone who knows it can read/post.
# e.g. morning-briefing-7f3k9q2x
NTFY_TOPIC=
# Override only if self-hosting ntfy. Default is the public server.
NTFY_SERVER=https://ntfy.sh

# --- News: GNews (https://gnews.io) --------------------------
GNEWS_API_KEY=
# Comma-separated. Options: general,world,nation,business,technology,
# entertainment,sports,science,health
NEWS_CATEGORIES=world,business,technology
NEWS_COUNTRY=us
NEWS_LANG=en

# --- Quotes: Quotable API needs no key. Nothing required. ----

# --- Stock ideas: yfinance needs no key. Nothing required. ---

# --- Misc ----------------------------------------------------
# IANA timezone used for the greeting/date line in the digest.
TIMEZONE=America/New_York
