# Copy to geofence.env (which is gitignored) and `chmod 600 geofence.env`.
# This is the shared secret every client must send in the X-Auth-Token header.
# Generate a strong one, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GEOFENCE_SECRET=replace-me-with-a-long-random-string

# Optional: point at a non-default config file.
# GEOFENCE_CONFIG=/home/pi/Morning--Agent/geofence.toml

# --- Telegram (Phase 2: departure alerts) ------------------------------------
# From @BotFather when you create the bot. Anyone holding this token IS your
# bot, so treat it like a password.
TELEGRAM_BOT_TOKEN=

# YOUR chat id -- the agent only sends here, and ignores commands from anyone
# else. Get it by messaging your bot, then:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# and reading result[0].message.chat.id
TELEGRAM_CHAT_ID=
